{% extends "base.jinja" %}
{% block title %}
    Books
{% endblock title %}
{% block content %}
    <h1>Books</h1>
    <div class="toolbar">
        <a class="btn btn-primary" href="{{ url_for('books.add_book_route') }}">Add Book</a>
    </div>
    <div class="books">
        {% for shelf_name, books in shelves.items() %}
            <div class="shelf">
                <div class="shelf-header">{{ shelf_name }}</div>
                <div class="book-grid book-grid--header">
                    <div>Title</div>
                    <div>Author(s)</div>
                    <div></div>
                </div>
                {% for book in books %}
                    <div class="book-grid book-row">
                        <div class="book-title">
                            {{ book.title }}
                            {% if book.subtitle %}: {{ book.subtitle }}{% endif %}
                        </div>
                        <div class="book-authors">
                            {% for book_author in book.authors %}
                                {{ book_author.author.display_name }}
                                {%- if not loop.last -%};{% endif %}
                            {% endfor %}
                        </div>
                        <div class="book-actions">
                            <div class="btn-group">
                                {% if book.is_loaned %}
                                    <a class="btn"
                                       href="{{ url_for('books.return_book_route', book_id=book.id) }}">Return</a>
                                {% else %}
                                    <a class="btn"
                                       href="{{ url_for('books.loan_book_route', book_id=book.id) }}">Loan</a>
                                {% endif %}
                                <a class="btn-outline-primary"
                                   href="{{ url_for('books.edit_book_route', book_id=book.id) }}">Edit</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endblock content %}
